<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.devbox.drop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>$HOME/bin/devbox-drop.sh</string>
  </array>
  <!-- Fire on any change to the drop folder... -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/YOUR_MAC_USERNAME/DevboxDrop</string>
  </array>
  <!-- ...and sweep every 30s as a safety net (WatchPaths can miss fast batches). -->
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
