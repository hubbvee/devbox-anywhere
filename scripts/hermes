#!/usr/bin/env bash
# hermes — give an orchestrator agent (or you) hands on every devbox tmux session.
# Thin wrapper over tmux list-sessions / capture-pane / send-keys. See docs/08.
#
# Runs in two places:
#   INSIDE the devbox (default)      — talks to tmux directly.
#   Anywhere with SSH to the devbox  — set HERMES_SSH, e.g.:  export HERMES_SSH=devbox
#                                      (an ssh alias for coder@YOUR_SERVER_IP -p 2222)
#
# Usage:
#   hermes ls                     list sessions (name, attached, activity)
#   hermes peek <session> [n]     last n lines (default 40) of the session's active pane
#   hermes send <session> <cmd…>  type cmd into the session and press Enter
#   hermes run  <session> <cmd…>  like send, but creates the session first if missing
#   hermes broadcast <cmd…>       send to EVERY session (asks for confirmation on a TTY)
#   hermes wait <session> <pat>   block until <pat> (grep -E) appears in the pane, 5s poll
#
# Install (inside the container): cp hermes ~/.local/bin/hermes && chmod +x ~/.local/bin/hermes
set -euo pipefail

t() {  # run a tmux command locally or over ssh, transparently
  if [ -n "${HERMES_SSH:-}" ]; then ssh "$HERMES_SSH" tmux "$@"; else tmux "$@"; fi
}

cmd="${1:-ls}"; shift || true
case "$cmd" in
  ls)
    t list-sessions -F '#{session_name}|attached=#{session_attached}|last-activity=#{t:session_activity}' 2>/dev/null \
      || echo "no sessions"
    ;;
  peek)
    s="${1:?usage: hermes peek <session> [lines]}"; n="${2:-40}"
    t capture-pane -p -t "=$s" -S "-$n"
    ;;
  send)
    s="${1:?usage: hermes send <session> <cmd...>}"; shift
    t send-keys -t "=$s" "$*" Enter
    ;;
  run)
    s="${1:?usage: hermes run <session> <cmd...>}"; shift
    t has-session -t "=$s" 2>/dev/null || t new-session -d -s "$s"
    t send-keys -t "=$s" "$*" Enter
    ;;
  broadcast)
    [ $# -ge 1 ] || { echo "usage: hermes broadcast <cmd...>" >&2; exit 1; }
    if [ -t 0 ]; then read -r -p "send '$*' to ALL sessions? [y/N] " ok; [ "$ok" = y ] || exit 1; fi
    for s in $(t list-sessions -F '#{session_name}' 2>/dev/null); do
      t send-keys -t "=$s" "$*" Enter
      echo "→ $s"
    done
    ;;
  wait)
    s="${1:?usage: hermes wait <session> <pattern>}"; pat="${2:?pattern required}"
    until t capture-pane -p -t "=$s" -S -200 | grep -qE "$pat"; do sleep 5; done
    echo "pattern matched in $s"
    ;;
  *)
    echo "unknown command: $cmd (ls|peek|send|run|broadcast|wait)" >&2; exit 1
    ;;
esac
