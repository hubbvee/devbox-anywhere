#!/usr/bin/env bash
# tmuxctl — give an orchestrator agent (or you) hands on every devbox tmux session.
# Thin wrapper over tmux list-sessions / capture-pane / send-keys. See docs/08.
#
# Runs in two places:
#   INSIDE the devbox (default)      — talks to tmux directly.
#   Anywhere with SSH to the devbox  — set HERMES_SSH, e.g.:  export HERMES_SSH=devbox
#                                      (private default: tunnel + coder@127.0.0.1:2222;
#                                      server IP only with explicit public mapping/firewall)
#
# Usage:
#   tmuxctl ls                     list sessions (name, attached, activity)
#   tmuxctl peek <session> [n]     last n lines (default 40) of the session's active pane
#   tmuxctl send <session> <cmd…>  type cmd into the session and press Enter
#   tmuxctl run  <session> <cmd…>  like send, but creates the session first if missing
#   tmuxctl broadcast --yes <cmd…> send to EVERY session (explicit opt-in required)
#   tmuxctl wait <session> <pat>   block until <pat> (grep -E) appears in the pane, 5s poll
#
# Install (inside the container): install -m 0700 scripts/hermes ~/.local/bin/tmuxctl
set -euo pipefail

t() {  # run a tmux command locally or over ssh, transparently
  if [ -n "${HERMES_SSH:-}" ]; then
    # OpenSSH normally joins arguments into a remote shell command. Pass a NUL-delimited
    # argv over stdin instead so payload metacharacters never become remote shell syntax.
    printf '%s\0' "$@" | ssh "$HERMES_SSH" \
      'python3 -c '\''import os, subprocess, sys; a=sys.stdin.buffer.read().split(b"\0"); a.pop() if a and a[-1] == b"" else None; r=subprocess.run(["tmux", *[os.fsdecode(x) for x in a]]); raise SystemExit(r.returncode)'\'''
  else
    tmux "$@"
  fi
}

cmd="${1:-ls}"; shift || true
case "$cmd" in
  ls)
    t list-sessions -F '#{session_name}|attached=#{session_attached}|last-activity=#{t:session_activity}' 2>/dev/null \
      || echo "no sessions"
    ;;
  peek)
    s="${1:?usage: hermes peek <session> [lines]}"; n="${2:-40}"
    t capture-pane -p -t "=$s:" -S "-$n"
    ;;
  send)
    s="${1:?usage: tmuxctl send <session> <cmd...>}"; shift
    [ $# -ge 1 ] || { echo "usage: tmuxctl send <session> <cmd...>" >&2; exit 1; }
    t send-keys -t "=$s:" -l -- "$*"
    t send-keys -t "=$s:" Enter
    ;;
  run)
    s="${1:?usage: tmuxctl run <session> <cmd...>}"; shift
    [ $# -ge 1 ] || { echo "usage: tmuxctl run <session> <cmd...>" >&2; exit 1; }
    t has-session -t "=$s:" 2>/dev/null || t new-session -d -s "$s"
    t send-keys -t "=$s:" -l -- "$*"
    t send-keys -t "=$s:" Enter
    ;;
  broadcast)
    [ "${1:-}" = --yes ] || { echo "usage: tmuxctl broadcast --yes <cmd...>" >&2; exit 1; }
    shift
    [ $# -ge 1 ] || { echo "usage: tmuxctl broadcast --yes <cmd...>" >&2; exit 1; }
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      t send-keys -t "=$s:" -l -- "$*"
      t send-keys -t "=$s:" Enter
      echo "→ $s"
    done < <(t list-sessions -F '#{session_name}' 2>/dev/null)
    ;;
  wait)
    s="${1:?usage: tmuxctl wait <session> <pattern>}"; pat="${2:?pattern required}"
    until t capture-pane -p -t "=$s:" -S -200 | grep -qE "$pat"; do sleep 5; done
    echo "pattern matched in $s"
    ;;
  *)
    echo "unknown command: $cmd (ls|peek|send|run|broadcast|wait)" >&2; exit 1
    ;;
esac
