#!/usr/bin/env bash
# devbox-session — resolve a project to its tmux session and agents.
#
# Model (see docs/13): one project == one tmux session (session name == project name);
# each agent is a tmux window backed by its own git worktree + branch. This tool is a
# read-only resolver over a registry directory maintained by devbox-worktree; it needs no
# live tmux and never invents a session, agent, or worktree.
#
# Registry: $DEVBOX_SESSION_HOME/<project>.tsv (default ~/.local/state/devbox/sessions), one row
# per agent: <agent-id>\t<worktree-path>\t<branch>[\t<fork-sha>]. The optional 4th column is
# the base tip at creation, recorded by devbox-worktree so status can tell a fresh branch
# (no commits yet) from a genuinely merged one. Agent ids must be "<project>-<suffix>".
#
# Usage:
#   devbox-session list                       list projects and their agents
#   devbox-session resolve <project>          print session=<project>
#   devbox-session resolve <project> <agent>  print session/window/worktree/branch
#   devbox-session status <project> [--json]  per-agent git/turn facts + activity heuristic
#
# status state column: new|new+dirty|clean|dirty|merged|merged+dirty, plus (reapable) when
# merged && clean && turn free && not working, and never while a window with the agent's name
# may exist but cannot be read reliably. A registered worktree that git cannot read is shown
# as ERROR ("error": true) and is never reapable; the other agents are still reported.
# Activity (working|idle|blocked|unknown) is a HEURISTIC: "working" = any non-shell
# foreground process in any pane of the agent's window, so an agent CLI idle at its own
# prompt reads "working" (it means "a CLI is open here", not "actively producing output").
# Output is safe to print: --json escapes every control byte, and the table and `list`
# replace anything but printable ASCII with '?'.
set -eu

# Registry lives under the persistent ~/.local mount (survives container rebuilds), where the
# helper actually runs as the container user. Override with DEVBOX_SESSION_HOME.
SESSION_HOME=${DEVBOX_SESSION_HOME:-${HOME:-/home/coder}/.local/state/devbox/sessions}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# Registry fields and turn holders are written by agents: for the table and `list`, show
# printable ASCII only (anything else, including ESC, CR and other control bytes -> '?').
shown() { printf '%s' "$1" | LC_ALL=C tr -c ' -~' '?'; }
# Same, for a column that must stay one word: a space becomes '?' too.
shown_word() { printf '%s' "$1" | LC_ALL=C tr -c '!-~' '?'; }

# A project/agent name must be a safe single path segment: no slashes, no dots-only,
# no leading dash. This blocks path traversal and tmux/option confusion.
safe_name() {
  case "$1" in
    ""|.|..) return 1 ;;
    */*|*'\'*) return 1 ;;
    -*) return 1 ;;
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

registry_of() {
  # echoes the registry file path for a validated project, or fails.
  safe_name "$1" || die "invalid project name: $1"
  printf '%s/%s.tsv' "$SESSION_HOME" "$1"
}

cmd=${1:-list}
shift 2>/dev/null || true

case "$cmd" in
  list)
    [ -d "$SESSION_HOME" ] || { echo "no sessions"; exit 0; }
    found=0
    for reg in "$SESSION_HOME"/*.tsv; do
      [ -e "$reg" ] || continue
      found=1
      project=$(basename "$reg" .tsv)
      printf 'project=%s session=%s\n' "$(shown_word "$project")" "$(shown_word "$project")"
      while IFS=$(printf '\t') read -r agent worktree branch rest; do
        [ -n "${agent:-}" ] || continue
        printf '  agent=%s window=%s worktree=%s branch=%s\n' "$(shown_word "$agent")" "$(shown_word "$agent")" "$(shown "$worktree")" "$(shown "$branch")"
      done < "$reg"
    done
    [ "$found" = 1 ] || echo "no sessions"
    ;;

  resolve)
    project=${1:-} || true
    [ -n "$project" ] || die "usage: devbox-session resolve <project> [agent]"
    reg=$(registry_of "$project")
    [ -f "$reg" ] || die "unknown project: $project"

    agent=${2:-}
    if [ -z "$agent" ]; then
      printf 'session=%s\n' "$project"
      exit 0
    fi

    safe_name "$agent" || die "invalid agent name: $agent"
    # Enforce the <project>-<suffix> convention so channels address agents unambiguously.
    case "$agent" in
      "$project"-?*) : ;;
      *) die "agent id must be '${project}-<suffix>': $agent" ;;
    esac

    # Look the agent up; fail closed on missing, duplicate, or malformed rows.
    matches=0
    m_worktree=; m_branch=
    while IFS=$(printf '\t') read -r r_agent r_worktree r_branch r_fork r_rest; do
      [ -n "${r_agent:-}" ] || continue
      # A well-formed row is 3 fields (legacy) or 4 (agent/worktree/branch/fork_sha). The 4th
      # column is the optional fork SHA written by devbox-worktree; reject a 5th column.
      [ -z "${r_rest:-}" ] || die "malformed registry row for $project: extra columns"
      if [ "$r_agent" = "$agent" ]; then
        [ -n "${r_worktree:-}" ] && [ -n "${r_branch:-}" ] || die "malformed registry row for $agent"
        matches=$((matches + 1))
        m_worktree=$r_worktree
        m_branch=$r_branch
      fi
    done < "$reg"

    [ "$matches" -eq 1 ] || {
      [ "$matches" -eq 0 ] && die "unknown agent: $agent"
      die "ambiguous agent (registered $matches times): $agent"
    }

    printf 'session=%s\nwindow=%s\nworktree=%s\nbranch=%s\n' "$project" "$agent" "$m_worktree" "$m_branch"
    ;;

  status)
    # Git-convergence readout per agent. Exact facts only: dirty, ahead/behind
    # vs base, merged (branch is an ancestor of base), turn holder, reapable. Activity is a heuristic.
    json=0
    project=""
    for a in "$@"; do
      case "$a" in
        --json) json=1 ;;
        -*) die "unknown status option: $a" ;;
        *) [ -z "$project" ] && project=$a || die "unexpected argument: $a" ;;
      esac
    done
    [ -n "$project" ] || die "usage: devbox-session status <project> [--json]"
    reg=$(registry_of "$project")
    [ -f "$reg" ] || die "unknown project: $project"
    base=${DEVBOX_STATUS_BASE:-}
    # Read-only: never take git's optional locks. A plain `git status` takes the worktree's
    # index.lock and rewrites the index to refresh stat data, so a status poll (e.g. through
    # the status gate) could make an agent's own git add/commit/rebase fail at random.
    GIT_OPTIONAL_LOCKS=0
    export GIT_OPTIONAL_LOCKS

    # JSON string body for arbitrary bytes. Registry fields and turn holders are written by
    # agents, so nothing here is trusted to be JSON-safe: backslash and quote are escaped,
    # every control byte (0x00-0x1f, 0x7f) becomes \u00XX, and if the value is not valid UTF-8
    # its bytes >= 0x80 become \u00XX too, so the document always parses.
    #
    # UTF-8 validity is checked here, byte by byte, to RFC 3629 (no overlong forms, no
    # surrogates, nothing above U+10FFFF, no 5/6-byte forms), not with iconv: glibc and macOS
    # iconv both pass U+110000 and 5/6-byte forms through UTF-8 -> UTF-8, and macOS iconv even
    # exits 0 for some invalid input once a valid character precedes it.
    utf8_ok() (
      LC_ALL=C
      _s=$1; _i=0; _need=0; _lo=128; _hi=191
      while [ "$_i" -lt "${#_s}" ]; do
        printf -v _b '%d' "'${_s:_i:1}" 2>/dev/null || exit 1
        _b=$(( _b & 255 ))
        _i=$((_i + 1))
        if [ "$_need" -gt 0 ]; then
          [ "$_b" -ge "$_lo" ] && [ "$_b" -le "$_hi" ] || exit 1
          _need=$((_need - 1)); _lo=128; _hi=191
        elif [ "$_b" -lt 128 ]; then :
        elif [ "$_b" -ge 194 ] && [ "$_b" -le 223 ]; then _need=1
        elif [ "$_b" -eq 224 ]; then _need=2; _lo=160
        elif [ "$_b" -eq 237 ]; then _need=2; _hi=159
        elif [ "$_b" -ge 225 ] && [ "$_b" -le 239 ]; then _need=2
        elif [ "$_b" -eq 240 ]; then _need=3; _lo=144
        elif [ "$_b" -eq 244 ]; then _need=3; _hi=143
        elif [ "$_b" -ge 241 ] && [ "$_b" -le 243 ]; then _need=3
        else exit 1; fi
      done
      [ "$_need" -eq 0 ]
    )

    jesc() (
      LC_ALL=C
      _s=$1
      case "$_s" in
        *[!\ -~]*) : ;;
        *) printf '%s' "$_s" | sed 's/\\/\\\\/g; s/"/\\"/g'; exit 0 ;;
      esac
      _hi=raw
      case "$_s" in
        *[!\ -~$'\001'-$'\037'$'\177']*)
          utf8_ok "$_s" || _hi=esc ;;
      esac
      _o=; _i=0
      while [ "$_i" -lt "${#_s}" ]; do
        _c=${_s:_i:1}
        _i=$((_i + 1))
        case "$_c" in
          '"') _o="$_o\\\"" ;;
          '\') _o="$_o\\\\" ;;
          [\ -~]) _o="$_o$_c" ;;
          [$'\001'-$'\037'$'\177']) _o="$_o$(printf '\\u%04x' "'$_c")" ;;
          *) if [ "$_hi" = raw ]; then _o="$_o$_c"; else _o="$_o$(printf '\\u00%02x' "$(( $(printf '%d' "'$_c") & 255 ))")"; fi ;;
        esac
      done
      printf '%s' "$_o"
    )

    turn_of() {
      # The holder's name, "free", or "unknown". "free" only from devbox-turn exiting 0 with
      # exactly "free: <worktree>"; a holder is read between the known "<worktree> by " prefix
      # and the final ", age=" and must be a plain name ([A-Za-z0-9._@+:-], never the words
      # free/unknown). An absent or failing devbox-turn, any other output, or any other holder
      # reads "unknown", which is never reapable (fail closed: a held turn never reads free).
      # Resolve devbox-turn beside this script first (helpers install together), then PATH.
      _dt="$(dirname "$0")/devbox-turn"
      [ -x "$_dt" ] || _dt=$(command -v devbox-turn 2>/dev/null) || { printf 'unknown'; return; }
      [ -n "$_dt" ] || { printf 'unknown'; return; }
      out=$(bash "$_dt" status "$1" 2>/dev/null) || { printf 'unknown'; return; }
      case "$out" in
        "free: $1") printf 'free'; return ;;
        "held: $1 by "*) _h=${out#"held: $1 by "} ;;
        "held (STALE, reclaimable): $1 by "*) _h=${out#"held (STALE, reclaimable): $1 by "} ;;
        *) printf 'unknown'; return ;;
      esac
      case "$_h" in *", age="*) _h=${_h%", age="*} ;; *) printf 'unknown'; return ;; esac
      case "$_h" in
        ''|free|unknown) printf 'unknown' ;;
        *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._@+:-]*) printf 'unknown' ;;
        *) printf '%s' "$_h" ;;
      esac
    }

    # ACTIVITY (HEURISTIC, not a fact): classify a pane as working|idle|blocked, else unknown.
    # A probe prints one TAB line "<foreground_cmd>\t<age_seconds>\t<last_line>" for
    # "<session> <window>"; empty output or a nonzero exit => unknown (NEVER fabricated as
    # working). Default probe uses tmux; overridable via DEVBOX_STATUS_ACTIVITY_CMD for tests
    # and non-tmux setups. Stall threshold DEVBOX_STATUS_STALE seconds (default 60).
    stale_secs=${DEVBOX_STATUS_STALE:-60}
    activity_probe=${DEVBOX_STATUS_ACTIVITY_CMD:-}
    if [ -z "$activity_probe" ] && command -v tmux >/dev/null 2>&1; then
      activity_probe="__tmux__"
    fi
    tab=$(printf '\t')
    # tmux_rows <session> <format>: print one "<format>" row per window of the session, or fail.
    # tmux prints window names and pane commands raw, so a newline inside one splits that window
    # into several lines and can forge a row for ANY window id (even another session's). Each row
    # is therefore prefixed with #{session_windows} (the first line's prefix is always genuine:
    # nothing precedes it) and the listing is accepted only when it has exactly that many lines.
    # The trailing "." keeps $(...) from trimming the newlines of a name that ENDS in one.
    tmux_rows() {
      _out=$(tmux list-windows -t "=$1" -F "#{session_windows}${tab}$2" 2>/dev/null && printf '.') || return 1
      _out=${_out%.}
      _n=${_out%%"$tab"*}
      case "$_n" in ''|*[!0-9]*) return 1 ;; esac
      [ "$(printf '%s' "$_out" | grep -c '')" -eq "$_n" ] || return 1
      printf '%s' "$_out" | cut -f2-
    }
    activity_of() {
      # args: <session> <window>. Prints the activity; "unknown held" means a window bearing the
      # agent's name may exist (ambiguous, inconsistent, or vanished mid-probe) but its activity is
      # not provable, so the caller must never let it count toward reapable.
      [ -n "$activity_probe" ] || { printf 'unknown'; return; }
      if [ "$activity_probe" = "__tmux__" ]; then
        tmux has-session -t "=$1" 2>/dev/null || { printf 'unknown'; return; }
        # Prove the agent's window exists EXACTLY before probing it. A name target ("=S:W", even
        # "=S:=W") is not safe: when W is missing, display-message silently falls back to the
        # session's current window and exits 0, so an agent with no window would report the main
        # shell's activity. Instead: list the session's windows (newline-forgery-proof, see
        # tmux_rows), match the name byte-for-byte (plain string compare, no glob/regex/prefix),
        # require exactly ONE hit (zero = provably no window, two+ = ambiguous), then address that
        # window only by its server-unique id (@N, never reused), which list-windows/capture-pane
        # resolve exactly or not at all. display-message is not used. Failure => unknown.
        wins=$(tmux_rows "$1" "#{window_id}${tab}#{window_name}") || { printf 'unknown held'; return; }
        wid=""; hits=0
        while IFS= read -r wl; do
          case "$wl" in @*"$tab"*) : ;; *) printf 'unknown held'; return ;; esac
          [ "${wl#*"$tab"}" = "$2" ] || continue
          hits=$((hits + 1)); wid=${wl%%"$tab"*}
        done <<< "$wins"
        [ "$hits" -ne 0 ] || { printf 'unknown'; return; }
        [ "$hits" -eq 1 ] || { printf 'unknown held'; return; }
        case "${wid#@}" in ''|*[!0-9]*) printf 'unknown held'; return ;; esac
        # Facts for that id only (no names in this format). A window gone since the listing => held.
        meta=$(tmux_rows "$1" "#{window_id}${tab}#{window_activity}${tab}#{pane_current_command}") || { printf 'unknown held'; return; }
        mrow=""; mn=0
        while IFS= read -r wl; do
          if [ "${wl%%"$tab"*}" = "$wid" ]; then mn=$((mn + 1)); mrow=${wl#*"$tab"}; fi
        done <<< "$meta"
        [ "$mn" -eq 1 ] || { printf 'unknown held'; return; }
        awin=${mrow%%"$tab"*}
        cmd=${mrow#*"$tab"}
        [ -n "$cmd" ] || { printf 'unknown held'; return; }
        # Every pane of that window, not only the active one: an agent CLI keeps running in a
        # pane that is not selected (the facts above and capture-pane below read the ACTIVE pane
        # only). Count-prefixed and line-counted like tmux_rows, since a pane command may hold
        # raw newlines; an unreadable or inconsistent listing => held. With two or more panes,
        # any non-shell command in any of them => working.
        panes=$(tmux list-panes -t "$wid" -F "#{window_panes}${tab}#{pane_current_command}" 2>/dev/null && printf '.') || { printf 'unknown held'; return; }
        panes=${panes%.}
        pn=${panes%%"$tab"*}
        case "$pn" in ''|*[!0-9]*) printf 'unknown held'; return ;; esac
        [ "$pn" -ge 1 ] && [ "$(printf '%s' "$panes" | grep -c '')" -eq "$pn" ] || { printf 'unknown held'; return; }
        pi=0; pbusy=""
        while [ "$pi" -lt "$pn" ] && IFS= read -r pl; do
          pi=$((pi + 1))
          case "$pl" in *"$tab"?*) : ;; *) printf 'unknown held'; return ;; esac
          case "${pl#*"$tab"}" in sh|bash|dash|zsh|-sh|-bash|-zsh|fish|tmux) : ;; *) pbusy=1 ;; esac
        done <<< "$panes"
        [ "$pi" -eq "$pn" ] || { printf 'unknown held'; return; }
        if [ "$pn" -gt 1 ] && [ -n "$pbusy" ]; then printf 'working'; return; fi
        now=$(date +%s 2>/dev/null)
        age=""; case "$awin$now" in *[!0-9]*) : ;; *) [ -n "$awin" ] && [ -n "$now" ] && age=$((now - awin)) ;; esac
        # The pane read must itself succeed (a window that vanished since the listing => held);
        # the trailing "." keeps the blank rows below the cursor that $(...) would trim.
        pane=$(tmux capture-pane -p -t "$wid" 2>/dev/null && printf '.') || { printf 'unknown held'; return; }
        last=$(printf '%s' "${pane%.}" | grep -n '[^[:space:]]' | tail -n1 | cut -d: -f2-)
        line="$cmd	${age:-}	$last"
      else
        line=$("$activity_probe" "$1" "$2" 2>/dev/null) || { printf 'unknown'; return; }
      fi
      [ -n "$line" ] || { printf 'unknown'; return; }
      pcmd=$(printf '%s' "$line" | cut -f1)
      page=$(printf '%s' "$line" | cut -f2)
      plast=$(printf '%s' "$line" | cut -f3-)
      [ -n "$pcmd" ] || { printf 'unknown'; return; }
      # blocked: last line looks like a program waiting for input AND it has stalled.
      case "$plast" in
        *"(y/n)"*|*"(yes/no)"*|*"[Y/n]"*|*"[y/N]"*|*"Password:"*|*"password:"*|*"? "*|*"?)"*)
          case "$page" in ''|*[!0-9]*) : ;; *) [ "$page" -ge "$stale_secs" ] && { printf 'blocked'; return; } ;; esac ;;
      esac
      # working: a non-shell foreground command.
      case "$pcmd" in
        sh|bash|dash|zsh|-sh|-bash|-zsh|fish|tmux) printf 'idle' ;;
        *) printf 'working' ;;
      esac
    }

    emit_json=""
    table=""
    first=1
    while IFS=$(printf '\t') read -r agent worktree branch fork rest; do
      [ -n "${agent:-}" ] || continue
      missing=false; broken=false; dirty=false; ahead=0; behind=0; merged=false; new=false; turn="free"; reapable=false; activity=unknown
      porcelain=""
      if [ ! -d "$worktree" ]; then
        missing=true
      elif ! porcelain=$(git -C "$worktree" status --porcelain 2>/dev/null); then
        # A registered directory git cannot read (not a repository, a broken .git link,
        # "dubious ownership", ...): that agent's own error state, never reapable, never a crash
        # that would hide the other agents.
        broken=true; turn=unknown
      else
        # base defaults: repo main, then master; fail closed only if none resolvable and none given
        b=$base
        if [ -z "$b" ]; then
          if git -C "$worktree" rev-parse --verify -q main >/dev/null 2>&1; then b=main
          elif git -C "$worktree" rev-parse --verify -q master >/dev/null 2>&1; then b=master
          else die "cannot resolve base branch (no main/master); set DEVBOX_STATUS_BASE"; fi
        fi
        [ -n "$porcelain" ] && dirty=true
        counts=$(git -C "$worktree" rev-list --left-right --count "$b"...HEAD 2>/dev/null) || counts=""
        if [ -n "$counts" ]; then
          behind=$(printf '%s' "$counts" | awk '{print $1}')
          ahead=$(printf '%s' "$counts" | awk '{print $2}')
        fi
        # new: the branch still sits exactly at its fork point -> no commits of its own yet.
        # A fresh branch is trivially an ancestor of base, so we must NOT call that "merged":
        # doing so made every just-created (possibly live) agent reapable.
        #   - 4-column rows: compare HEAD to the fork SHA recorded by devbox-worktree.
        #   - legacy 3-column rows (created before the upgrade): fall back to the branch reflog.
        #     A branch with only its creation entry ("Created from ...") has no commits of its
        #     own -> new. If the reflog is unreadable we cannot tell, so newness_known stays
        #     false and the agent is never reapable (fail safe: never reap what we can't judge).
        tip=$(git -C "$worktree" rev-parse HEAD 2>/dev/null) || tip=""
        newness_known=false
        if [ -n "$fork" ]; then
          newness_known=true
          if [ -n "$tip" ] && [ "$tip" = "$fork" ]; then new=true; fi
        else
          rlog=$(git -C "$worktree" reflog show --format=%gs "$branch" 2>/dev/null) || rlog=""
          if [ -n "$rlog" ]; then
            newness_known=true
            nlines=$(printf '%s\n' "$rlog" | grep -c .)
            oldest=$(printf '%s\n' "$rlog" | grep . | tail -n1)
            case "$oldest" in
              *"Created from"*) [ "$nlines" -eq 1 ] && new=true ;;
            esac
          fi
        fi
        # merged: an ancestor of base AND it has moved past its fork point (real history merged in).
        if [ "$new" = false ] && git -C "$worktree" merge-base --is-ancestor "$branch" "$b" 2>/dev/null; then merged=true; fi
        turn=$(turn_of "$worktree")
        # ACTIVITY is a HEURISTIC (session==project, window==agent); never blocks the git facts.
        # Computed before reapable so an actively-working agent is never flagged reapable.
        activity=$(activity_of "$project" "$agent")
        held=false
        case "$activity" in "unknown held") activity=unknown; held=true ;; esac
        if [ "$merged" = true ] && [ "$newness_known" = true ] && [ "$dirty" = false ] && [ "$turn" = free ] && [ "$activity" != working ]; then reapable=true; fi
        # A window bearing the agent's name may be live but unprovable (held): never reapable. Only
        # a provable absence (no session, no such window) or a provable non-working state may reap.
        if [ "$held" = true ]; then reapable=false; fi
      fi

      if [ "$json" = 1 ]; then
        [ "$first" = 1 ] || emit_json="$emit_json,"
        first=0
        emit_json="$emit_json{\"agent\":\"$(jesc "$agent")\",\"worktree\":\"$(jesc "$worktree")\",\"branch\":\"$(jesc "$branch")\",\"missing\":$missing,\"error\":$broken,\"dirty\":$dirty,\"ahead\":$ahead,\"behind\":$behind,\"merged\":$merged,\"new\":$new,\"turn\":\"$(jesc "$turn")\",\"reapable\":$reapable,\"activity\":\"$(jesc "$activity")\"}"
      else
        if [ "$missing" = true ]; then
          table="$table$(printf '%-16s %s\n' "$(shown_word "$agent")" "MISSING")"$'\n'
        elif [ "$broken" = true ]; then
          table="$table$(printf '%-16s %s\n' "$(shown_word "$agent")" "ERROR")"$'\n'
        else
          # Show every state that is set; dirty is never hidden (new+dirty / merged+dirty).
          if [ "$new" = true ] && [ "$dirty" = true ]; then gs="new+dirty"
          elif [ "$new" = true ]; then gs="new"
          elif [ "$merged" = true ] && [ "$dirty" = true ]; then gs="merged+dirty"
          elif [ "$merged" = true ]; then gs="merged"
          elif [ "$dirty" = true ]; then gs="dirty"
          else gs="clean"; fi
          reap=""; [ "$reapable" = true ] && reap="  (reapable)"
          table="$table$(printf '%-16s %-12s +%s/-%s  turn:%-10s %-8s%s\n' "$(shown_word "$agent")" "$gs" "$ahead" "$behind" "$(shown_word "$turn")" "$activity" "$reap")"$'\n'
        fi
      fi
    done < "$reg"

    if [ "$json" = 1 ]; then
      printf '{"schema_version":1,"project":"%s","session":"%s","base":"%s","activity_confidence":"heuristic","agents":[%s]}\n' \
        "$(jesc "$project")" "$(jesc "$project")" "$(jesc "${base:-auto}")" "$emit_json"
    else
      printf 'project=%s session=%s base=%s  (activity is a heuristic)\n' "$project" "$project" "$(shown_word "${base:-auto}")"
      printf '%s' "$table"
    fi
    ;;

  -h|--help|help)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    ;;

  *)
    die "unknown command: $cmd (list|resolve|status)"
    ;;
esac
