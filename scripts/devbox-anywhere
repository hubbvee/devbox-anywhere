#!/usr/bin/python3
"""Machine-readable orchestration harness for Devbox Anywhere agents."""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys
import re
import stat
from typing import Any, NamedTuple

SCHEMA_VERSION = 2
REAL_ROOT = pathlib.Path(__file__).resolve().parents[1]
ROOT = REAL_ROOT
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
DOCKER_CONFIG = "/nonexistent/devbox-anywhere-docker-config"
SOURCE_ROOT = pathlib.Path("/opt/devbox-anywhere")
STATE_DIR = pathlib.Path("/data/devbox/install")
STATE_ANCESTRY = (pathlib.Path("/data"), pathlib.Path("/data/devbox"), STATE_DIR)
ENV_FILE = STATE_DIR / "compose.env"
# Named instances (install-devbox --instance NAME) live beside the default one: /data/devbox-NAME.
INSTANCE_PARENT = pathlib.Path("/data")
EXPECTED_STATE_OWNER = 0
JSON_REQUESTED = "--json" in sys.argv[1:]
# Keep in sync with INSTANCE_RE / RESERVED_INSTANCES / PORT_RE in scripts/install-devbox
# (tests pin both). No hyphens or path characters: devbox-NAME stays a single path component
# and can never equal another instance's devbox-OTHER-browser container.
INSTANCE_PATTERN = r"[a-z][a-z0-9]{0,14}"
RESERVED_INSTANCES = frozenset({"browser", "default", "devbox"})
PORT_PATTERN = r"[1-9][0-9]{3,4}"
DEFAULT_PORTS = frozenset({"8080", "2222", "8081"})
BASE_SETTINGS = frozenset({"DEVBOX_DATA_ROOT", "DEVBOX_WEB_BIND", "DEVBOX_SSH_BIND"})
INSTANCE_SETTINGS = frozenset({
    "DEVBOX_INSTANCE", "DEVBOX_PROJECT", "COMPOSE_PROJECT_NAME", "DEVBOX_CONTAINER", "DEVBOX_WEB_PORT", "DEVBOX_SSH_PORT",
})


class Target(NamedTuple):
    """Which devbox a command inspects. The default reproduces the historical fixed values."""
    instance: str | None
    container: str
    project: str | None
    data_root: str
    state_ancestry: tuple[pathlib.Path, ...]
    env_file: pathlib.Path


def default_target() -> Target:
    return Target(None, "devbox", None, "/data/devbox", STATE_ANCESTRY, ENV_FILE)


def valid_instance(name: str) -> bool:
    return re.fullmatch(INSTANCE_PATTERN, name) is not None and name not in RESERVED_INSTANCES


def instance_target(name: str) -> Target:
    # Every path and name is derived ONLY from the validated name.
    if not valid_instance(name):
        raise ValueError("invalid instance name")
    base = INSTANCE_PARENT / f"devbox-{name}"
    state = base / "install"
    return Target(name, f"devbox-{name}", f"devbox-{name}", f"/data/devbox-{name}", (INSTANCE_PARENT, base, state), state / "compose.env")


def valid_ports(web: str | None, ssh: str | None, browser: str | None) -> bool:
    """Instance host ports: decimal 1024-65535, pairwise distinct, never a default-instance port."""
    chosen = [port for port in (web, ssh, browser) if port is not None]
    if web is None or ssh is None or len(set(chosen)) != len(chosen):
        return False
    return all(
        re.fullmatch(PORT_PATTERN, port) is not None and 1024 <= int(port) <= 65535 and port not in DEFAULT_PORTS
        for port in chosen
    )


def instance_summary(target: Target, ports: dict[str, str] | None = None) -> dict[str, Any]:
    summary: dict[str, Any] = {
        "name": target.instance,
        "project": target.project,
        "container": target.container,
        "data_root": target.data_root,
    }
    if ports:
        summary.update(ports)
    return summary


def check(check_id: str, passed: bool, summary: str) -> dict[str, str]:
    return {"id": check_id, "status": "pass" if passed else "fail", "summary": summary}


def warn_check(check_id: str, ok: bool, summary: str) -> dict[str, str]:
    # Warn-only: a non-ok result is "warn", never "fail", so it cannot clear the aggregate ok.
    # AGENTS.md step 8 gates installs on verify --json ok: true; these checks must not start
    # blocking installs that passed yesterday. Promotion to fail is a later release.
    return {"id": check_id, "status": "pass" if ok else "warn", "summary": summary}


# Constant-argv container probes (run as `/bin/sh -c "$PROBE"` inside devbox, same constant-argv
# discipline as the installer preservation blob). Output is machine-parsed and carries only link
# paths / daemon names -- never environment values or secrets. POSIX sh only (container may be dash).
RELINK_TARGETS_PROBE = r"""
# relink.targets probe: emit one DANGLING line per managed symlink that is genuinely broken.
# Two classes of managed links are judged by DIFFERENT rules because they behave differently.
#
# SHIPPED defaults -- the top-level `relink "$HOME/..." "$HOME/..."` lines in devbox-relink
# (terminfo, gh-config, gitconfig, secrets). These are WRITE-THROUGH: relink creates the symlink
# before the source exists, and the tool (git config, gh auth login, ...) writes THROUGH it into
# the persisted ~/.local/share store on first use. So a shipped link whose source does not exist
# yet is HEALTHY on a fresh box, not dangling. The only broken state is a shipped path that
# EXISTS but is NOT a symlink -- then writes won't survive a rebuild.
#   - GUARD 1b (parser): match ONLY `relink "$HOME/<t>" "$HOME/<l>"` with literal $HOME/ args at
#     column zero. The drop-in loader's own indented `relink "$target" "$link"` call is neither
#     column-zero nor $HOME/-rooted, so it never matches; if a loosened grep ever lets a non
#     $HOME/-rooted line through, the case guard below surfaces it loudly rather than emitting a
#     silent bogus pair. This kills the old `"$link" -> "$target"` leak.
#   - GUARD 1a: flag a shipped link that is ABSENT (relink never ran) or exists but is NOT a
#     symlink; a dangling symlink (source not yet created) stays healthy (write-through).
#
# DROP-IN links -- every ~/.local/share/devbox-relink.d/*.conf pair. The loader SKIPS a missing
# source (never creates the link), so a drop-in link that exists but does not resolve means the
# source was removed AFTER the link was made: a genuine dangling target (the ~/.hermes case
# this check exists for). Flag any drop-in link that is absent, not a symlink, or does not resolve.
rl="$HOME/.local/bin/devbox-relink"
dd="$HOME/.local/share/devbox-relink.d"
if [ -f "$rl" ]; then
  grep -E '^relink[[:space:]]+"\$HOME/[^"]*"[[:space:]]+"\$HOME/[^"]*"' "$rl" | while IFS= read -r line; do
    rest=$(printf '%s\n' "$line" | sed -n 's/^[[:space:]]*relink[[:space:]]\{1,\}\(.*\)/\1/p')
    target=$(printf '%s\n' "$rest" | sed -n 's/^"\([^"]*\)".*/\1/p')
    link=$(printf '%s\n' "$rest" | sed -n 's/^"[^"]*"[[:space:]]\{1,\}"\([^"]*\)".*/\1/p')
    # GUARD 1b: a managed shipped pair is exactly two $HOME/-rooted quoted paths. Anything else
    # (e.g. the loader's `relink "$target" "$link"`) is surfaced, never parsed as a real link.
    case "$target" in '$HOME/'*) ;; *) printf 'DANGLING %s -> %s\n' "$link" "$target"; continue ;; esac
    case "$link"   in '$HOME/'*) ;; *) printf 'DANGLING %s -> %s\n' "$link" "$target"; continue ;; esac
    t=$(eval printf %s "\"$target\""); l=$(eval printf %s "\"$link\"")
    # GUARD 1a: relink ALWAYS creates every shipped link, so an ABSENT link (relink never ran)
    # or a path that exists but is NOT a symlink (writes won't persist) is broken. A dangling
    # symlink (source not created yet) stays healthy -- that is the write-through fresh-box state.
    if [ ! -L "$l" ]; then printf 'DANGLING %s -> %s\n' "$l" "$t"; fi
  done
fi
if [ -d "$dd" ]; then
  for c in "$dd"/*.conf; do
    [ -e "$c" ] || continue
    while read -r target link extra || [ -n "$target" ]; do
      case "$target" in ''|\#*) continue ;; esac
      [ -n "$link" ] && [ -z "$extra" ] || continue
      t=$(eval printf %s "\"$target\""); l=$(eval printf %s "\"$link\"")
      if [ ! -L "$l" ] || [ ! -e "$l" ]; then printf 'DANGLING %s -> %s\n' "$l" "$t"; fi
    done < "$c"
  done
fi
"""

DAEMON_DECLARED_PROBE = r"""
# daemon.declared probe: emit "<name>	<running|stopped>" per declared daemon. Absent daemons.d
# emits nothing, so the check is skipped rather than failed.
#
# Liveness delegates to `devbox-daemon status-all` when that helper is present -- it is the single,
# backend-aware source of truth (a non-tmux backend is judged by that backend, never by a raw tmux
# has-session). Only when devbox-daemon is absent (an install predating it) do we fall back to the
# raw tmux check, so those installs keep working. status-all already prints the exact
# <name>	tab	<running|stopped> contract this probe returns.
dd="$HOME/.local/share/devbox-daemons.d"
[ -d "$dd" ] || exit 0
if command -v devbox-daemon >/dev/null 2>&1; then
  devbox-daemon status-all
  exit 0
fi
# Fallback (no devbox-daemon): raw tmux check of the default backend only.
for c in "$dd"/*.conf; do
  [ -e "$c" ] || continue
  name=$(sed -n 's/^name[[:space:]]\{1,\}//p' "$c" | head -1)
  [ -n "$name" ] || continue
  sess=$(sed -n 's/^tmux_session[[:space:]]\{1,\}//p' "$c" | head -1)
  [ -n "$sess" ] || sess="$name"
  if tmux has-session -t "$sess" 2>/dev/null; then
    printf '%s\trunning\n' "$name"
  else
    printf '%s\tstopped\n' "$name"
  fi
done
"""


def emit_error(command: str, message: str, exit_code: int, as_json: bool) -> int:
    if as_json:
        print(json.dumps({
            "schema_version": SCHEMA_VERSION,
            "command": command,
            "ok": False,
            "error": {"code": exit_code, "message": message},
        }, sort_keys=True))
    else:
        print(f"ERROR: {message}", file=sys.stderr)
    return exit_code


def run(command: list[str], *, clean: bool = False) -> subprocess.CompletedProcess[str]:
    env = {
        "PATH": SAFE_PATH,
        "HOME": "/root",
        "LANG": "C",
        "LC_ALL": "C",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "DOCKER_CONFIG": DOCKER_CONFIG,
    } if clean else None
    try:
        return subprocess.run(command, env=env, capture_output=True, text=True, timeout=20)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(command, 124, "", "command timed out")


def available(name: str) -> str | None:
    return shutil.which(name, path=SAFE_PATH)


def docker_result(docker: str, arguments: list[str]) -> subprocess.CompletedProcess[str]:
    return run([docker, "--context", "default", *arguments], clean=True)


def git_result(arguments: list[str]) -> subprocess.CompletedProcess[str]:
    git = available("git")
    if not git:
        return subprocess.CompletedProcess(["git", *arguments], 127, "", "Git is unavailable")
    return run([
        git,
        f"--git-dir={ROOT / '.git'}",
        f"--work-tree={ROOT}",
        "-c", "core.fsmonitor=false",
        "-c", "core.hooksPath=/dev/null",
        *arguments,
    ], clean=True)


def preflight(as_json: bool, target: Target) -> int:
    checks: list[dict[str, str]] = []
    uname = available("uname")
    linux = bool(uname and run([uname, "-s"], clean=True).stdout.strip() == "Linux")
    checks.append(check("os.linux", linux, "Linux host" if linux else "Linux is required"))

    tools: dict[str, str | None] = {name: available(name) for name in ("python3", "git", "docker", "openssl")}
    for name in ("python3", "git", "docker", "openssl"):
        checks.append(check(f"{name}.available", tools[name] is not None, f"{name} is available" if tools[name] else f"{name} is missing"))

    compose_ok = False
    daemon_ok = False
    if tools["docker"]:
        compose_ok = docker_result(tools["docker"], ["compose", "version"]).returncode == 0
        daemon_ok = docker_result(tools["docker"], ["info"]).returncode == 0
    checks.append(check("compose.v2", compose_ok, "Docker Compose v2 is available" if compose_ok else "Docker Compose v2 is unavailable"))
    checks.append(check("docker.daemon", daemon_ok, "Docker daemon is reachable" if daemon_ok else "Docker daemon is unreachable"))

    report: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "command": "preflight",
        "ok": all(item["status"] == "pass" for item in checks),
        "source": {"path": str(ROOT)},
        "network": {"web_bind": "127.0.0.1", "ssh_bind": "127.0.0.1"},
        "checks": checks,
    }
    if target.instance:
        report["instance"] = instance_summary(target)
    if as_json:
        print(json.dumps(report, sort_keys=True))
    else:
        for item in checks:
            print(f"{item['status'].upper():4} {item['id']}: {item['summary']}")
    return 0 if report["ok"] else 1


def plan(
    as_json: bool,
    approved_commit: str,
    expose_ssh: bool,
    with_browser: bool,
    target: Target,
    web_port: str | None = None,
    ssh_port: str | None = None,
    browser_port: str | None = None,
) -> int:
    if not re.fullmatch(r"[0-9a-f]{40}", approved_commit):
        return emit_error("plan", "--approved-commit requires an exact 40-character lowercase commit SHA", 2, as_json)
    if not target.instance:
        if web_port is not None or ssh_port is not None or browser_port is not None:
            return emit_error("plan", "--web-port, --ssh-port and --browser-port require --instance", 2, as_json)
        web_port, ssh_port, browser_port = "8080", "2222", "8081"
    else:
        if (browser_port is not None) != with_browser or not valid_ports(web_port, ssh_port, browser_port):
            return emit_error(
                "plan",
                "--instance requires --web-port and --ssh-port (and --browser-port iff --with-browser): "
                "decimal 1024-65535, distinct, not 8080/2222/8081",
                2,
                as_json,
            )
    commit = git_result(["cat-file", "-e", f"{approved_commit}^{{commit}}"])
    installer = git_result(["cat-file", "-e", f"{approved_commit}:scripts/install-devbox"])
    head = git_result(["rev-parse", "HEAD"])
    if commit.returncode != 0 or installer.returncode != 0:
        return emit_error("plan", "approved commit is not present as an installer-bearing commit in this repository", 1, as_json)
    if head.returncode != 0 or head.stdout.strip() != approved_commit:
        return emit_error("plan", "inspected checkout HEAD does not match the approved commit", 1, as_json)
    ssh_bind = "0.0.0.0" if expose_ssh else "127.0.0.1"
    approvals = ["sudo", "container build/start"]
    if expose_ssh:
        approvals.append("firewall/public SSH exposure")
    if with_browser:
        approvals.append("interactive browser service")
    command = f"sudo /opt/devbox-anywhere/scripts/install-devbox --yes --approved-commit {approved_commit}"
    if expose_ssh:
        command += " --expose-ssh"
    if with_browser:
        command += " --with-browser"
    if target.instance:
        command += f" --instance {target.instance} --web-port {web_port} --ssh-port {ssh_port}"
        if with_browser:
            command += f" --browser-port {browser_port}"
    network = {"web_bind": "127.0.0.1", "ssh_bind": ssh_bind}
    if with_browser:
        network["browser_bind"] = f"127.0.0.1:{browser_port}"
    report: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "command": "plan",
        "ok": True,
        "mutates": False,
        "approved_commit": approved_commit,
        "source_path": "/opt/devbox-anywhere",
        "data_root": target.data_root,
        "network": network,
        "approval_required": approvals,
        "install_command": command,
    }
    if target.instance:
        ports = {"web_port": web_port, "ssh_port": ssh_port}
        if with_browser:
            ports["browser_port"] = browser_port
        report["instance"] = instance_summary(target, ports)
    if as_json:
        print(json.dumps(report, sort_keys=True))
    else:
        print(f"Approved commit: {approved_commit}")
        listeners = f"Web: 127.0.0.1:{web_port}; SSH: {ssh_bind}:{ssh_port}"
        if with_browser:
            listeners += f"; Browser: 127.0.0.1:{browser_port}"
        print(listeners)
        print(f"Command after approval: {command}")
    return 0


def deployment_settings(target: Target) -> dict[str, str]:
    allowed = set(BASE_SETTINGS)
    if target.instance:
        allowed |= INSTANCE_SETTINGS | {"DEVBOX_BROWSER_PORT"}
    settings: dict[str, str] = {}
    for path in target.state_ancestry:
        try:
            state = path.lstat()
        except OSError:
            return settings
        if not stat.S_ISDIR(state.st_mode) or stat.S_ISLNK(state.st_mode):
            return settings
        if state.st_uid != EXPECTED_STATE_OWNER or state.st_mode & 0o022:
            return settings
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(target.env_file, flags)
    except OSError:
        return settings
    try:
        state = os.fstat(descriptor)
        if not stat.S_ISREG(state.st_mode) or state.st_uid != EXPECTED_STATE_OWNER or state.st_mode & 0o077:
            return settings
        with os.fdopen(descriptor, "r", encoding="utf-8", errors="strict") as stream:
            descriptor = -1
            content = stream.read(65537)
        if len(content) > 65536:
            return settings
    except (OSError, UnicodeError):
        return settings
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    for line in content.splitlines():
        key, separator, value = line.partition("=")
        if separator and key in allowed:
            if key in settings:
                return {}
            settings[key] = value
    if settings.get("DEVBOX_DATA_ROOT") != target.data_root:
        return {}
    if settings.get("DEVBOX_WEB_BIND") != "127.0.0.1":
        return {}
    if settings.get("DEVBOX_SSH_BIND") not in {"127.0.0.1", "0.0.0.0"}:
        return {}
    if target.instance:
        if not INSTANCE_SETTINGS <= set(settings):
            return {}
        if (settings["DEVBOX_INSTANCE"], settings["DEVBOX_PROJECT"], settings["COMPOSE_PROJECT_NAME"], settings["DEVBOX_CONTAINER"]) != (
            target.instance, target.project, target.project, target.container,
        ):
            return {}
        if not valid_ports(settings["DEVBOX_WEB_PORT"], settings["DEVBOX_SSH_PORT"], settings.get("DEVBOX_BROWSER_PORT")):
            return {}
    return settings


def expected_ports(target: Target, settings: dict[str, str]) -> tuple[str, str]:
    """Host (web, ssh) ports the target's container must publish."""
    if target.instance:
        return settings.get("DEVBOX_WEB_PORT", ""), settings.get("DEVBOX_SSH_PORT", "")
    return "8080", "2222"


def verify_report(target: Target) -> dict[str, Any]:
    checks: list[dict[str, str]] = []
    settings = deployment_settings(target)
    if target.instance:
        state_ok = BASE_SETTINGS | INSTANCE_SETTINGS <= set(settings)
    else:
        state_ok = set(settings) == {"DEVBOX_DATA_ROOT", "DEVBOX_WEB_BIND", "DEVBOX_SSH_BIND"}
    container = target.container
    checks.append(check("state.file", state_ok, "installer state and ancestry are safe" if state_ok else "installer state or ancestry is missing or unsafe"))
    docker = available("docker")
    if not docker:
        if target.instance:
            checks.append(check("container.project", False, "Docker is missing"))
        for check_id, summary in (
            ("container.running", "Docker is missing"),
            ("network.bindings", "Docker is missing"),
            ("storage.mounts", "Docker is missing"),
            ("helper.devbox", "Docker is missing"),
            ("helper.devbox-daemon", "Docker is missing"),
            ("helper.devbox-relink", "Docker is missing"),
            ("helper.devbox-session", "Docker is missing"),
            ("helper.devbox-turn", "Docker is missing"),
            ("helper.devbox-worktree", "Docker is missing"),
            ("service.http", "Docker is missing"),
            ("service.ssh", "Docker is missing"),
        ):
            checks.append(check(check_id, False, summary))
    else:
        def docker_ok(arguments: list[str]) -> bool:
            return docker_result(docker, arguments).returncode == 0

        if target.instance:
            # A named instance's container must belong to its own Compose project, never to a
            # hand-made container that merely reuses the name.
            project_result = docker_result(docker, ["inspect", "--format", '{{index .Config.Labels "com.docker.compose.project"}}', container])
            project_ok = project_result.returncode == 0 and project_result.stdout.strip() == target.project
            checks.append(check(
                "container.project",
                project_ok,
                f"{container} belongs to Compose project {target.project}" if project_ok else f"{container} is not managed by Compose project {target.project}",
            ))
        running_result = docker_result(docker, ["inspect", "-f", "{{.State.Running}}", container])
        running = running_result.returncode == 0 and running_result.stdout.strip() == "true"
        checks.append(check("container.running", running, f"{container} container is running" if running else f"{container} container is not running"))
        bindings_result = docker_result(docker, ["inspect", "--format", "{{json .NetworkSettings.Ports}}", container])
        bindings_ok = False
        if bindings_result.returncode == 0 and state_ok:
            try:
                actual_bindings = json.loads(bindings_result.stdout)
            except (json.JSONDecodeError, TypeError):
                actual_bindings = None
            web_port, ssh_port = expected_ports(target, settings)
            expected_bindings = {
                "8080/tcp": [{"HostIp": settings["DEVBOX_WEB_BIND"], "HostPort": web_port}],
                "22/tcp": [{"HostIp": settings["DEVBOX_SSH_BIND"], "HostPort": ssh_port}],
            }
            bindings_ok = actual_bindings == expected_bindings
        checks.append(check(
            "network.bindings",
            bindings_ok,
            "Docker port bindings match installer state" if bindings_ok else "Docker port bindings differ from installer state",
        ))
        mounts_result = docker_result(docker, ["inspect", "--format", "{{json .Mounts}}", container])
        mounts_ok = False
        if mounts_result.returncode == 0:
            try:
                mounts = json.loads(mounts_result.stdout)
            except (json.JSONDecodeError, TypeError):
                mounts = None
            expected_mounts = {
                (f"{target.data_root}/{leaf}", destination)
                for leaf, destination in (
                    ("project", "/home/coder/project"),
                    ("dot-local", "/home/coder/.local"),
                    ("claude", "/home/coder/.claude"),
                    ("codex", "/home/coder/.codex"),
                    ("ssh", "/home/coder/.ssh"),
                )
            }
            if isinstance(mounts, list) and len(mounts) == len(expected_mounts):
                actual_mounts = {
                    (item.get("Source"), item.get("Destination"))
                    for item in mounts
                    if isinstance(item, dict) and item.get("Type") == "bind" and item.get("RW") is True
                }
                mounts_ok = actual_mounts == expected_mounts
        checks.append(check(
            "storage.mounts",
            mounts_ok,
            "Docker mounts match fixed persistent paths" if mounts_ok else "Docker mounts differ from fixed persistent paths",
        ))
        for helper in ("devbox", "devbox-daemon", "devbox-relink", "devbox-session", "devbox-turn", "devbox-worktree"):
            ok = docker_ok(["exec", "--user", "coder", "--env", "PATH=/usr/bin:/bin", container, "/usr/bin/test", "-x", f"/home/coder/.local/bin/{helper}"])
            checks.append(check(f"helper.{helper}", ok, f"{helper} helper is executable" if ok else f"{helper} helper is unavailable"))
        http_ok = docker_ok(["exec", "--user", "coder", "--env", "PATH=/usr/bin:/bin", container, "/usr/bin/wget", "-q", "--spider", "http://127.0.0.1:8080/"])
        ssh_ok = docker_ok(["exec", "--user", "coder", "--env", "PATH=/usr/bin:/bin", container, "/usr/bin/ssh-keyscan", "-T", "2", "-p", "22", "127.0.0.1"])
        checks.append(check("service.http", http_ok, "code-server responds inside the container" if http_ok else "code-server readiness failed"))
        checks.append(check("service.ssh", ssh_ok, "SSH responds inside the container" if ssh_ok else "SSH readiness failed"))

        # relink.targets (warn-only): every symlink devbox-relink manages must resolve. A dangling
        # or missing target is surfaced as a warn naming the path -- previously invisible (a
        # dangling ~/.hermes still returned ok: true).
        relink_probe = docker_result(docker, ["exec", "--user", "coder", "--env", "PATH=/usr/bin:/bin", container, "/bin/sh", "-c", RELINK_TARGETS_PROBE])
        if relink_probe.returncode == 0:
            dangling = [line[len("DANGLING "):] for line in relink_probe.stdout.splitlines() if line.startswith("DANGLING ")]
            if dangling:
                checks.append(warn_check("relink.targets", False, "unresolved relink targets: " + "; ".join(dangling)))
            else:
                checks.append(warn_check("relink.targets", True, "all relink targets resolve"))
        else:
            checks.append(warn_check("relink.targets", False, "relink target probe could not run"))

        # daemon.<name> (warn-only): each declared daemon should be running. Absent daemons.d ->
        # no daemon checks (skipped, not failed). A declared-but-down daemon is a warn.
        daemon_probe = docker_result(docker, ["exec", "--user", "coder", "--env", "PATH=/usr/bin:/bin", container, "/bin/sh", "-c", DAEMON_DECLARED_PROBE])
        if daemon_probe.returncode == 0:
            for line in daemon_probe.stdout.splitlines():
                if not line.strip():
                    continue
                parts = line.split("\t")
                name = parts[0].strip()
                state = parts[1].strip() if len(parts) > 1 else "stopped"
                if not name:
                    continue
                running = state == "running"
                checks.append(warn_check(f"daemon.{name}", running, f"{name} daemon is running" if running else f"{name} daemon is declared but not running"))
    report: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "command": "verify",
        "ok": all(item["status"] != "fail" for item in checks),
        "network": {
            "web_bind": settings.get("DEVBOX_WEB_BIND", "unknown"),
            "ssh_bind": settings.get("DEVBOX_SSH_BIND", "unknown"),
        },
        "checks": checks,
    }
    if target.instance:
        report["instance"] = instance_summary(target, {
            "web_port": settings.get("DEVBOX_WEB_PORT", "unknown"),
            "ssh_port": settings.get("DEVBOX_SSH_PORT", "unknown"),
        })
    return report


def verify(as_json: bool, target: Target) -> int:
    report = verify_report(target)
    if as_json:
        print(json.dumps(report, sort_keys=True))
    else:
        for item in report["checks"]:
            print(f"{item['status'].upper():4} {item['id']}: {item['summary']}")
    return 0 if report["ok"] else 1


def diagnose(as_json: bool, target: Target) -> int:
    verification = verify_report(target)
    failed = [item["id"] for item in verification["checks"] if item["status"] == "fail"]
    clean_docker = f"sudo env -i PATH={SAFE_PATH} HOME=/root LANG=C LC_ALL=C DOCKER_CONFIG={DOCKER_CONFIG} docker --context default"
    project = f"-p {target.project} " if target.project else ""
    selector = f" --instance {target.instance}" if target.instance else ""
    recovery = [
        f"{clean_docker} logs {target.container}",
        f"{clean_docker} compose {project}--env-file {target.env_file} -f {SOURCE_ROOT / 'stack/docker-compose.yml'} ps",
        f"./scripts/devbox-anywhere verify --json{selector}",
    ]
    report: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "command": "diagnose",
        "ok": not failed,
        "failed_checks": failed,
        "recovery_commands": recovery if failed else [],
        "note": "Commands may expose operational logs; inspect locally and do not paste credentials into chat.",
    }
    if target.instance:
        report["instance"] = verification["instance"]
    if as_json:
        print(json.dumps(report, sort_keys=True))
    else:
        print("No failures detected." if not failed else f"Failed checks: {', '.join(failed)}")
        for command in report["recovery_commands"]:
            print(f"  {command}")
    return 0 if report["ok"] else 1


def not_implemented(command: str) -> int:
    print(f"ERROR: {command} is not implemented yet", file=sys.stderr)
    return 2


class HarnessParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        if JSON_REQUESTED:
            known = {"preflight", "plan", "verify", "diagnose"}
            command = next((item for item in sys.argv[1:] if item in known), "unknown")
            if "unrecognized arguments:" in message:
                safe_message = "unknown option"
            elif "invalid choice:" in message:
                safe_message = "invalid command"
            elif "required" in message:
                safe_message = "required argument missing"
            else:
                safe_message = "invalid arguments"
            emit_error(command, safe_message, 2, True)
            self.exit(2)
        if "unrecognized arguments:" in message:
            message = "unknown option"
        self.print_usage(sys.stderr)
        self.exit(2, f"ERROR: {message}\n")


class Once(argparse.Action):
    """Store a value, refusing a repeat (argparse is last-wins) like the installer's once()."""

    def __call__(self, parser: argparse.ArgumentParser, namespace: argparse.Namespace, values: Any, option_string: str | None = None) -> None:
        if getattr(namespace, self.dest, None) is not None:
            # Names only the option, never the rejected value.
            parser.error(f"{option_string} may be given only once")
        setattr(namespace, self.dest, values)


def parser() -> argparse.ArgumentParser:
    result = HarnessParser(
        prog="devbox-anywhere",
        description="Agent-facing preflight, plan, verification, and diagnosis harness.",
    )
    subcommands = result.add_subparsers(dest="command", required=True)
    for name in ("preflight", "plan", "verify", "diagnose"):
        command = subcommands.add_parser(name)
        command.add_argument("--json", action="store_true", help="emit schema-versioned JSON")
        command.add_argument("--instance", action=Once, help="named instance (install-devbox --instance NAME)")
        if name == "plan":
            command.add_argument("--approved-commit", required=True)
            command.add_argument("--expose-ssh", action="store_true")
            command.add_argument("--with-browser", action="store_true")
            command.add_argument("--web-port", action=Once)
            command.add_argument("--ssh-port", action=Once)
            command.add_argument("--browser-port", action=Once)
    return result


def main() -> int:
    args = parser().parse_args()
    target = default_target()
    if args.instance is not None:
        # The rejected value is never echoed (same redaction rule as unknown options).
        if not valid_instance(args.instance):
            return emit_error(args.command, f"--instance must match {INSTANCE_PATTERN} and not be a reserved name", 2, args.json)
        target = instance_target(args.instance)
    if args.command == "preflight":
        return preflight(args.json, target)
    if args.command == "plan":
        return plan(
            args.json, args.approved_commit, args.expose_ssh, args.with_browser, target,
            args.web_port, args.ssh_port, args.browser_port,
        )
    if args.command == "verify":
        return verify(args.json, target)
    if args.command == "diagnose":
        return diagnose(args.json, target)
    return not_implemented(args.command)


if __name__ == "__main__":
    raise SystemExit(main())
