#!/usr/bin/env bash
# Recreate home-dir symlinks into the persisted ~/.local after a container rebuild.
# Everything real lives on the /data/devbox/dot-local bind mount; only these links die
# with the container. The entrypoint runs this at every boot, so rebuilds are hands-off.
# Safe to re-run anytime.
#
# Install (inside the container): cp devbox-relink ~/.local/bin/ && chmod +x ~/.local/bin/devbox-relink
#
# PATTERN: whenever a CLI stores its login/config OUTSIDE ~/.local (e.g. ~/.config/<tool>),
# move the real dir into ~/.local/share/ once, then add a relink line here. The tool's
# auth then survives rebuilds like everything else.
#   mv ~/.config/mytool ~/.local/share/mytool-config
#   relink "$HOME/.local/share/mytool-config" "$HOME/.config/mytool"
set -e
relink() {
  local target=$1 link=$2
  if [ -e "$link" ] && [ ! -L "$link" ]; then mv "$link" "$link.pre-relink.bak"; fi
  ln -sfn "$target" "$link"
  echo "  $link -> $target"
}
mkdir -p "$HOME/.config"
echo "relinking:"
relink "$HOME/.local/share/terminfo"   "$HOME/.terminfo"      # exotic TERMs (ghostty/kitty), see docs/05
relink "$HOME/.local/share/gh-config"  "$HOME/.config/gh"     # GitHub CLI login
relink "$HOME/.local/share/gitconfig"  "$HOME/.gitconfig"     # user-level git config
relink "$HOME/.local/secrets"          "$HOME/.secrets"       # shared main.env, see docs/06
# Add your own tools below (one line per tool):
# relink "$HOME/.local/share/mytool-config" "$HOME/.config/mytool"
