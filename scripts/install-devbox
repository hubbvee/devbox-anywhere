#!/usr/bin/env bash
# Guided, resumable plain-Docker installer for humans and coding agents.
set -euo pipefail
umask 077

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DATA_ROOT=/data/devbox
WEB_BIND=127.0.0.1
SSH_BIND=127.0.0.1
ASSUME_YES=0
DRY_RUN=0
WITH_BROWSER=0
APPROVED_COMMIT=
# Named instances (opt-in): a second, independent devbox on the same server. Without
# --instance every name, path, port and the Compose project stay exactly as before.
INSTANCE=
WEB_PORT=
SSH_PORT=
BROWSER_PORT=
# Instance names: lowercase letter, then up to 14 lowercase letters/digits. No hyphens or
# path characters, so devbox-NAME can never collide with devbox-OTHER-browser or escape /data.
# Keep in sync with INSTANCE_PATTERN in scripts/devbox-anywhere (tests pin both).
INSTANCE_RE='^[a-z][a-z0-9]{0,14}$'
# Reserved: "browser" would yield devbox-browser (the default instance's browser container);
# "default" and "devbox" are ambiguous with the default instance.
RESERVED_INSTANCES="browser default devbox"
PORT_RE='^[1-9][0-9]{3,4}$'
# Host ports of the default instance; a named instance must never claim them.
DEFAULT_PORTS="8080 2222 8081"

usage() {
  cat <<'EOF'
Usage: sudo ./scripts/install-devbox [options]

Safely prepares persistent storage, builds Devbox Anywhere with Docker Compose,
installs the in-container helpers, and verifies the result. Re-running is safe.

Options:
  --yes                 accept the displayed plan (required without a TTY)
  --dry-run             print the resolved plan without changing anything
  --expose-ssh          bind SSH to 0.0.0.0 instead of loopback; firewall first
  --with-browser        also run the opt-in interactive GUI browser (loopback noVNC)
  --approved-commit SHA exact reviewed commit authorized by the user
  -h, --help            show this help

Named instance (opt-in; a second devbox on the same server):
  --instance NAME       NAME matches ^[a-z][a-z0-9]{0,14}$ and is not browser, default
                        or devbox. Uses data root /data/devbox-NAME, container devbox-NAME
                        (browser: devbox-NAME-browser) and Compose project devbox-NAME.
  --web-port N          loopback host port for code-server (required with --instance)
  --ssh-port N          host port for SSH (required with --instance)
  --browser-port N      loopback host port for noVNC (required iff --with-browser)
Ports are decimal 1024-65535, pairwise distinct, never 8080/2222/8081 (the default
instance), and must not already be listening. Port options require --instance.

The installer never accepts passwords on the command line. It generates a random
code-server password and stores it in an owner-only environment file.
EOF
}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need_arg() { [[ $# -ge 2 && -n ${2:-} ]] || die "$1 requires a value"; }
# Byte-wise (C locale) matching so [a-z] can never admit uppercase or non-ASCII letters.
matches() { local LC_ALL=C; [[ $1 =~ $2 ]]; }
once() { [[ -z $2 ]] || die "$1 may be given only once"; }

while (($#)); do
  case "$1" in
    --yes) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;

    --expose-ssh) SSH_BIND=0.0.0.0; shift ;;
    --with-browser) WITH_BROWSER=1; shift ;;
    --approved-commit) need_arg "$@"; APPROVED_COMMIT=$2; shift 2 ;;
    --instance) need_arg "$@"; once "$1" "$INSTANCE"; INSTANCE=$2; shift 2 ;;
    --web-port) need_arg "$@"; once "$1" "$WEB_PORT"; WEB_PORT=$2; shift 2 ;;
    --ssh-port) need_arg "$@"; once "$1" "$SSH_PORT"; SSH_PORT=$2; shift 2 ;;
    --browser-port) need_arg "$@"; once "$1" "$BROWSER_PORT"; BROWSER_PORT=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

[[ $APPROVED_COMMIT =~ ^[0-9a-f]{40}$ ]] || die "--approved-commit requires an exact 40-character lowercase commit SHA"

CONTAINER=devbox
PROJECT=
if [[ -z $INSTANCE ]]; then
  [[ -z $WEB_PORT && -z $SSH_PORT && -z $BROWSER_PORT ]] \
    || die "--web-port, --ssh-port and --browser-port require --instance"
  WEB_PORT=8080
  SSH_PORT=2222
  BROWSER_PORT=8081
else
  matches "$INSTANCE" "$INSTANCE_RE" || die "--instance must match $INSTANCE_RE"
  for reserved in $RESERVED_INSTANCES; do
    [[ $INSTANCE != "$reserved" ]] || die "--instance name is reserved: $INSTANCE"
  done
  unset reserved
  [[ -n $WEB_PORT && -n $SSH_PORT ]] || die "--instance requires --web-port and --ssh-port"
  if ((WITH_BROWSER)); then
    [[ -n $BROWSER_PORT ]] || die "--instance with --with-browser requires --browser-port"
  else
    [[ -z $BROWSER_PORT ]] || die "--browser-port requires --with-browser"
  fi
  # An array, never word splitting: " 9080" must be rejected, not silently trimmed.
  chosen_ports=("$WEB_PORT" "$SSH_PORT")
  if [[ -n $BROWSER_PORT ]]; then chosen_ports+=("$BROWSER_PORT"); fi
  for port in "${chosen_ports[@]}"; do
    matches "$port" "$PORT_RE" && ((port >= 1024 && port <= 65535)) \
      || die "ports must be decimal integers from 1024 to 65535"
    for reserved in $DEFAULT_PORTS; do
      [[ $port != "$reserved" ]] || die "port $port belongs to the default instance"
    done
  done
  [[ $WEB_PORT != "$SSH_PORT" && $WEB_PORT != "$BROWSER_PORT" && $SSH_PORT != "$BROWSER_PORT" ]] \
    || die "--web-port, --ssh-port and --browser-port must be distinct"
  unset port reserved
  # Everything below is derived ONLY from the validated name.
  DATA_ROOT=$DATA_ROOT-$INSTANCE
  CONTAINER=devbox-$INSTANCE
  PROJECT=devbox-$INSTANCE
fi
BROWSER_CONTAINER=$CONTAINER-browser

STATE_DIR=$DATA_ROOT/install
ENV_FILE=$STATE_DIR/compose.env
# Non-secret instance settings persisted in compose.env (Compose reads the container name and
# ports from them; the harness reads them back). Empty for the default instance, whose file
# keeps exactly its historical contents. COMPOSE_PROJECT_NAME is defense in depth: a manual
# `compose --env-file` that forgets -p still targets this instance's project, never "stack".
instance_settings=
if [[ -n $INSTANCE ]]; then
  instance_settings="DEVBOX_INSTANCE=$INSTANCE
DEVBOX_PROJECT=$PROJECT
COMPOSE_PROJECT_NAME=$PROJECT
DEVBOX_CONTAINER=$CONTAINER
DEVBOX_WEB_PORT=$WEB_PORT
DEVBOX_SSH_PORT=$SSH_PORT"
  if ((WITH_BROWSER)); then
    instance_settings="$instance_settings
DEVBOX_BROWSER_PORT=$BROWSER_PORT"
  fi
fi

cat <<EOF
Devbox Anywhere installation plan
  repository: $REPO_ROOT
  approved commit: $APPROVED_COMMIT
  persistent data: $DATA_ROOT
  browser: $WEB_BIND:$WEB_PORT (HTTP; put authenticated HTTPS in front)
  SSH: $SSH_BIND:$SSH_PORT (key-only; no key is added automatically)
  GUI browser (optional): $([[ $WITH_BROWSER == 1 ]] && printf '%s' "$WEB_BIND:$BROWSER_PORT noVNC (enabled)" || printf 'disabled')
  credentials: $ENV_FILE (owner-only; value not printed)
  action: build and start stack/docker-compose.yml, then verify it
EOF
if [[ -n $INSTANCE ]]; then
  cat <<EOF
  instance: $INSTANCE
  Compose project: $PROJECT
  container: $CONTAINER$([[ $WITH_BROWSER == 1 ]] && printf '%s' " (browser: $BROWSER_CONTAINER)")
EOF
fi

if [[ $SSH_BIND == 0.0.0.0 || $SSH_BIND == :: ]]; then
  printf 'WARNING: SSH will listen on every interface. Restrict port %s with a firewall.\n' "$SSH_PORT"
fi

if ((DRY_RUN)); then
  cat <<EOF

Resolved Compose values (password intentionally redacted):
DEVBOX_PASSWORD=<generated-or-preserved>
DEVBOX_DATA_ROOT=$DATA_ROOT
DEVBOX_WEB_BIND=$WEB_BIND
DEVBOX_SSH_BIND=$SSH_BIND
EOF
  if [[ -n $INSTANCE ]]; then
    printf '%s\n' "$instance_settings"
  fi
  cat <<EOF
port: $WEB_BIND:$WEB_PORT:8080
port: $SSH_BIND:$SSH_PORT:22
volume: $DATA_ROOT/project:/home/coder/project
EOF
  if ((WITH_BROWSER)); then
    cat <<EOF
DEVBOX_BROWSER_BIND=$WEB_BIND
DEVBOX_BROWSER_PASSWORD=<generated-or-preserved>
port: $WEB_BIND:$BROWSER_PORT:3000
volume: $DATA_ROOT/browser:/config
EOF
  fi
  if ((!ASSUME_YES)) && [[ ! -t 0 ]]; then
    die "noninteractive installation requires --yes"
  fi
  exit 0
fi

if ((!ASSUME_YES)); then
  [[ -t 0 ]] || die "noninteractive installation requires --yes"
  read -r -p 'Continue? [y/N] ' answer
  [[ $answer == y || $answer == Y ]] || die "cancelled"
fi

[[ $(uname -s) == Linux ]] || die "the server installer supports Linux; use the guide for other hosts"
if ((EUID != 0)); then die "run this installer with sudo so it can prepare $DATA_ROOT"; fi
SAFE_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DOCKER_CONFIG=/nonexistent/devbox-anywhere-docker-config
PATH=$SAFE_PATH
export PATH
command -v git >/dev/null || die "Git is required to verify the approved source"
GIT=$(command -v git)
command -v docker >/dev/null || die "Docker is not installed"
DOCKER=$(command -v docker)
compose_env=(env -i PATH="$SAFE_PATH" HOME=/root DOCKER_CONFIG="$DOCKER_CONFIG")
git_env=(env -i PATH="$SAFE_PATH" HOME=/root GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null)
git_cmd=("${git_env[@]}" "$GIT" --git-dir="$REPO_ROOT/.git" --work-tree="$REPO_ROOT" \
  -c core.fsmonitor=false -c core.hooksPath=/dev/null)
docker_cmd=("${compose_env[@]}" "$DOCKER" --context default)
"${docker_cmd[@]}" compose version >/dev/null 2>&1 || die "Docker Compose v2 is not available"
command -v openssl >/dev/null || die "openssl is required to generate the browser password"
"${docker_cmd[@]}" info >/dev/null 2>&1 || die "the Docker daemon is not reachable"

# Root Docker must never consume a mutable agent-owned checkout. The documented workflow
# creates this checkout as root. Validate the whole same-filesystem tree before Docker.
[[ $REPO_ROOT == /opt/devbox-anywhere ]] || die "privileged installation must run from /opt/devbox-anywhere"
[[ ! -L /opt && $(stat -c %u /opt) == 0 ]] || die "/opt must be a root-owned non-symlink directory"
opt_mode=$(stat -c %a /opt)
(( (8#$opt_mode & 0022) == 0 )) || die "/opt must not be group/other writable"
unset opt_mode
[[ ! -L $REPO_ROOT ]] || die "repository root must not be a symlink"
while IFS= read -r -d '' source_path; do
  [[ $(stat -c %u "$source_path") == 0 ]] || die "source input is not root-owned: $source_path"
  source_mode=$(stat -c %a "$source_path")
  (( (8#$source_mode & 0022) == 0 )) || die "source input is group/other writable: $source_path"
done < <(find "$REPO_ROOT" -xdev -print0)
unset source_mode source_path
for source_path in stack/docker-compose.yml stack/Dockerfile stack/entrypoint.sh scripts/devbox scripts/devbox-relink scripts/devbox-session scripts/devbox-turn scripts/devbox-worktree; do
  [[ -f $REPO_ROOT/$source_path && ! -L $REPO_ROOT/$source_path ]] \
    || die "required source input must be a regular non-symlink file: $source_path"
done
actual_commit=$("${git_cmd[@]}" rev-parse HEAD)
[[ $actual_commit == "$APPROVED_COMMIT" ]] || die "checkout HEAD $actual_commit does not match approved commit $APPROVED_COMMIT"
[[ -z $("${git_cmd[@]}" status --porcelain=v1 --untracked-files=all) ]] \
  || die "approved checkout is not clean"
verify_dir=$(mktemp -d /tmp/devbox-source.XXXXXX)
trap 'rm -rf "$verify_dir"' EXIT
"${git_cmd[@]}" archive "$APPROVED_COMMIT" | tar -x -C "$verify_dir"
diff -qr --no-dereference --exclude=.git "$verify_dir" "$REPO_ROOT" >/dev/null \
  || die "checkout bytes differ from approved commit"
rm -rf "$verify_dir"
trap - EXIT
unset actual_commit source_path verify_dir

[[ ! -L /data ]] || die "/data must not be a symlink"
install -d -o 0 -g 0 -m 0755 /data
[[ $(stat -c %u /data) == 0 ]] || die "/data must be owned by root"
data_mode=$(stat -c %a /data)
(( (8#$data_mode & 0022) == 0 )) || die "/data must not be group/other writable"
unset data_mode
[[ ! -L $DATA_ROOT ]] || die "data root must not be a symlink"
install -d -m 0750 "$DATA_ROOT"
[[ $(stat -c %u "$DATA_ROOT") == 0 ]] || die "$DATA_ROOT must be owned by root"
data_root_mode=$(stat -c %a "$DATA_ROOT")
(( (8#$data_root_mode & 0022) == 0 )) || die "$DATA_ROOT must not be group/other writable"
unset data_root_mode
data_dirs="project dot-local claude codex ssh"
if ((WITH_BROWSER)); then data_dirs="$data_dirs browser"; fi
for path in $data_dirs; do
  [[ ! -L $DATA_ROOT/$path ]] || die "$DATA_ROOT/$path must not be a symlink"
  install -d -o 1000 -g 1000 -m 0700 "$DATA_ROOT/$path"
done
[[ ! -L $STATE_DIR ]] || die "$STATE_DIR must not be a symlink"
install -d -o 0 -g 0 -m 0700 "$STATE_DIR"
[[ $(stat -c %u "$STATE_DIR") == 0 ]] || die "$STATE_DIR must be owned by root"
state_mode=$(stat -c %a "$STATE_DIR")
(( (8#$state_mode & 0077) == 0 )) || die "$STATE_DIR must not be accessible to group/other"
unset state_mode

if [[ -L $ENV_FILE ]]; then die "$ENV_FILE must not be a symlink"; fi
if [[ -e $ENV_FILE && ! -f $ENV_FILE ]]; then die "$ENV_FILE is not a regular file"; fi
if [[ -f $ENV_FILE ]]; then
  [[ $(stat -c %u "$ENV_FILE") == 0 ]] || die "$ENV_FILE must be owned by root"
  env_mode=$(stat -c %a "$ENV_FILE")
  (( (8#$env_mode & 0077) == 0 )) || die "$ENV_FILE must not be accessible to group/other"
  unset env_mode
fi

if [[ -n $INSTANCE ]]; then
  # Never adopt a container this instance did not create: an existing devbox-NAME (or its
  # browser container) must carry this instance's Compose project label, or we stop before
  # Compose could recreate it. Compose also adopts by project label, not by name, so any OTHER
  # container already labeled with this project could be recreated (stopped and removed) by
  # `up`; refuse that too. One listing of every container; any unexpected shape fails.
  container_list=$("${docker_cmd[@]}" container ls --all --format '{{.Names}} {{.Label "com.docker.compose.project"}}') \
    || die "could not list existing containers"
  while read -r listed_name listed_project listed_extra; do
    if [[ $listed_name == "$CONTAINER" || $listed_name == "$BROWSER_CONTAINER" ]]; then
      [[ $listed_project == "$PROJECT" && -z $listed_extra ]] \
        || die "container $listed_name exists but is not managed by Compose project $PROJECT; refusing to touch it"
    elif [[ $listed_project == "$PROJECT" ]]; then
      die "container $listed_name already belongs to Compose project $PROJECT; refusing to recreate it"
    fi
  done <<<"$container_list"
  unset container_list listed_name listed_project listed_extra
  # Refuse host ports that something is already listening on. Ports this instance recorded
  # on a previous run are exempt (its own container holds them; Compose fails closed if not).
  owned_ports=
  if [[ -f $ENV_FILE ]]; then
    while IFS= read -r env_line; do
      case $env_line in
        DEVBOX_WEB_PORT=*|DEVBOX_SSH_PORT=*|DEVBOX_BROWSER_PORT=*) owned_ports="$owned_ports ${env_line#*=}" ;;
      esac
    done <"$ENV_FILE"
    unset env_line
  fi
  command -v ss >/dev/null || die "ss is required to check that the chosen ports are free"
  listening=$(ss -Hltn) || die "could not list listening TCP ports"
  listening_ports=
  # Every non-empty line must be "LISTEN RECV-Q SEND-Q LOCAL:PORT PEER ...": a short, wrapped or
  # unexpected line is never skipped (it could hide a listener on a chosen port).
  while read -r -a ss_fields; do
    ((${#ss_fields[@]})) || continue
    ((${#ss_fields[@]} >= 5)) && [[ ${ss_fields[0]} == LISTEN ]] || die "unexpected listening socket line from ss"
    listened=${ss_fields[3]##*:}
    matches "$listened" '^[0-9]+$' || die "unexpected listening socket line from ss"
    listening_ports="$listening_ports $listened"
  done <<<"$listening"
  for port in "${chosen_ports[@]}"; do
    [[ " $owned_ports " != *" $port "* ]] || continue
    [[ "$listening_ports " != *" $port "* ]] || die "host port $port is already in use"
  done
  unset owned_ports listening listening_ports ss_fields listened port
fi

tmp_env=$(mktemp "$STATE_DIR/compose.env.XXXXXX")
chmod 0600 "$tmp_env"
trap 'rm -f "$tmp_env"' EXIT
# Resolve the noVNC password unconditionally. Modern Docker Compose interpolates ${VAR:?}
# for EVERY service in the file, including profile-gated services that are not selected, so
# the default (no-browser) install must still define DEVBOX_BROWSER_PASSWORD or `compose
# build` fails. The value is owner-only and never printed; it is only consumed when the
# browser profile is actually started. Preserve an existing value across re-runs.
if [[ -f $ENV_FILE ]] && existing_browser_pw=$(grep -m1 '^DEVBOX_BROWSER_PASSWORD=' "$ENV_FILE"); then
  browser_pw_line=$existing_browser_pw
else
  browser_pw_line="DEVBOX_BROWSER_PASSWORD=$(openssl rand -base64 36 | tr -d '\n')"
fi
unset existing_browser_pw
if [[ ! -f $ENV_FILE ]]; then
  password=$(openssl rand -base64 36 | tr -d '\n')
  cat >"$tmp_env" <<EOF
DEVBOX_PASSWORD=$password
DEVBOX_DATA_ROOT=$DATA_ROOT
DEVBOX_WEB_BIND=$WEB_BIND
DEVBOX_SSH_BIND=$SSH_BIND
DEVBOX_BROWSER_BIND=$WEB_BIND
$browser_pw_line
EOF
  unset password
  if [[ -n $INSTANCE ]]; then printf '%s\n' "$instance_settings" >>"$tmp_env"; fi
else
  grep -q '^DEVBOX_PASSWORD=' "$ENV_FILE" || die "$ENV_FILE lacks DEVBOX_PASSWORD"
  # Preserve the password but refresh non-secret deployment settings.
  password_line=$(grep -m1 '^DEVBOX_PASSWORD=' "$ENV_FILE")
  cat >"$tmp_env" <<EOF
$password_line
DEVBOX_DATA_ROOT=$DATA_ROOT
DEVBOX_WEB_BIND=$WEB_BIND
DEVBOX_SSH_BIND=$SSH_BIND
DEVBOX_BROWSER_BIND=$WEB_BIND
$browser_pw_line
EOF
  unset password_line
  if [[ -n $INSTANCE ]]; then printf '%s\n' "$instance_settings" >>"$tmp_env"; fi
fi
unset browser_pw_line
mv -f "$tmp_env" "$ENV_FILE"
trap - EXIT HUP INT TERM

compose=("${docker_cmd[@]}" compose)
# A named instance always passes its project explicitly. The default instance keeps the
# directory-derived project ("stack") so existing installs are never re-created.
if [[ -n $INSTANCE ]]; then
  compose+=(-p "$PROJECT")
fi
compose+=(--env-file "$ENV_FILE" -f "$REPO_ROOT/stack/docker-compose.yml")
if ((WITH_BROWSER)); then
  compose+=(--profile browser)
fi
"${compose[@]}" build --pull=false
"${compose[@]}" up -d

helpers="devbox devbox-daemon devbox-relink devbox-session devbox-turn devbox-worktree"
# A3: preserve operator customization across upgrades (fixes D1). Constant-argv backup: a
# differing on-box helper is copied to <helper>.pre-upgrade.<utc>.bak before overwrite, with a
# machine-readable PRESERVED notice; an identical file is left untouched. For devbox-relink we
# also report any operator in-file `relink` lines not in the shipped file and point at the
# drop-in dir -- reported only, never auto-migrated. Deliberately uses `sh -c` instead of the
# plain `install` path so the exec argv is byte-identical for all helpers and across re-installs.
preserve_install_blob='set -e
h=$1
base=$2
src=/tmp/$h
dst=$base/$h
if [ -e "$dst" ] && ! cmp -s "$src" "$dst"; then
  bak=$dst.pre-upgrade.$(date -u +%Y%m%dT%H%M%SZ).bak
  cp -p "$dst" "$bak"
  printf "PRESERVED %s %s\\n" "$dst" "$bak"
  if [ "$h" = devbox-relink ]; then
    shipped=$(mktemp)
    grep -E "^[[:space:]]*relink " "$src" 2>/dev/null > "$shipped" || true
    grep -E "^[[:space:]]*relink " "$dst" 2>/dev/null | grep -vxF -f "$shipped" > "${shipped}.x" || true
    if [ -s "${shipped}.x" ]; then
      printf "CUSTOM_RELINK_LINES %s preserved in %s; re-add as ~/.local/share/devbox-relink.d/*.conf (not auto-migrated)\\n" "$dst" "$bak"
      while IFS= read -r line; do printf "CUSTOM_RELINK_LINE %s\\n" "$line"; done < "${shipped}.x"
    fi
    rm -f "$shipped" "${shipped}.x"
  fi
fi
install -m 0755 "$src" "$dst"'
for helper in $helpers; do
  "${docker_cmd[@]}" cp "$REPO_ROOT/scripts/$helper" "$CONTAINER:/tmp/$helper"
  "${docker_cmd[@]}" exec --user coder --env PATH=/usr/bin:/bin "$CONTAINER" \
    /bin/sh -c "$preserve_install_blob" _ "$helper" /home/coder/.local/bin
  "${docker_cmd[@]}" exec --user root --env PATH=/usr/sbin:/usr/bin:/sbin:/bin "$CONTAINER" /usr/bin/rm -f "/tmp/$helper"
done
# A3: ensure the upgrade-safe operator drop-in dir exists at 0700. Created only if absent
# (mkdir -p is a no-op when present); the installer never writes into it.
"${docker_cmd[@]}" exec --user coder --env PATH=/usr/bin:/bin "$CONTAINER" \
  /usr/bin/mkdir -p -m 0700 /home/coder/.local/share/devbox-relink.d
# C2: the declared-daemon drop-in dir, same 0700, never written into by the installer.
"${docker_cmd[@]}" exec --user coder --env PATH=/usr/bin:/bin "$CONTAINER" \
  /usr/bin/mkdir -p -m 0700 /home/coder/.local/share/devbox-daemons.d

# Build the readiness probe from the same helper list so it always matches what we installed.
readiness='/usr/bin/tmux -V >/dev/null'
for helper in $helpers; do
  readiness="$readiness && /usr/bin/test -x \"\$HOME/.local/bin/$helper\""
done

for attempt in $(seq 1 30); do
  if [[ $("${docker_cmd[@]}" inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null) == true ]] \
    && "${docker_cmd[@]}" exec --user coder --env PATH=/usr/bin:/bin "$CONTAINER" /bin/sh -c \
      "$readiness" 2>/dev/null \
    && "${docker_cmd[@]}" exec --user coder --env PATH=/usr/bin:/bin "$CONTAINER" \
      /usr/bin/wget -q --spider http://127.0.0.1:8080/ 2>/dev/null \
    && "${docker_cmd[@]}" exec --user coder --env PATH=/usr/bin:/bin "$CONTAINER" \
      /usr/bin/ssh-keyscan -T 2 -p 22 127.0.0.1 >/dev/null 2>&1; then
    break
  fi
  [[ $attempt -lt 30 ]] || die "container did not become ready; inspect: sudo env -i PATH=$SAFE_PATH HOME=/root DOCKER_CONFIG=$DOCKER_CONFIG docker --context default logs $CONTAINER"
  sleep 2
done

cat <<EOF

Installation complete.
  Browser (local/server): http://$WEB_BIND:$WEB_PORT
  Password file: $ENV_FILE
  Read password locally: sudo sed -n 's/^DEVBOX_PASSWORD=//p' '$ENV_FILE'
  Add an SSH public key: sudo sh -c 'cat >> "$DATA_ROOT/ssh/authorized_keys"'
  Status: sudo env -i PATH=$SAFE_PATH HOME=/root DOCKER_CONFIG=$DOCKER_CONFIG docker --context default compose ${PROJECT:+-p $PROJECT }--env-file '$ENV_FILE' -f '$REPO_ROOT/stack/docker-compose.yml' ps
EOF

if [[ $SSH_BIND == 127.0.0.1 ]]; then
  cat <<EOF
  Default private SSH access:
    1. ssh -L $SSH_PORT:127.0.0.1:$SSH_PORT HOST_USER@SERVER_ADDRESS
    2. In another terminal: ssh -p $SSH_PORT coder@127.0.0.1
EOF
else
  printf '  Direct SSH after adding a key: ssh -p %s coder@SERVER_ADDRESS\n' "$SSH_PORT"
fi

if ((WITH_BROWSER)); then
  cat <<EOF

  Interactive browser (noVNC), loopback-only on $WEB_BIND:$BROWSER_PORT:
    Read noVNC password locally: sudo sed -n 's/^DEVBOX_BROWSER_PASSWORD=//p' '$ENV_FILE'
    Reach it privately: ssh -L $BROWSER_PORT:127.0.0.1:$BROWSER_PORT HOST_USER@SERVER_ADDRESS then open http://127.0.0.1:$BROWSER_PORT
  Never expose port $BROWSER_PORT publicly. See docs/12-browser-and-auth.md.
EOF
fi

cat <<EOF

Do not expose port $WEB_PORT directly. Put authenticated HTTPS in front of it or keep it
loopback-only. Expose SSH only after configuring a restrictive firewall.
EOF