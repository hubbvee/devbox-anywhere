# <project>/.env.op — COMMITTED to the repo (zero secrets, only vault references).
# Any devbox clone regenerates its real (gitignored) env file with:
#
#   op inject -i .env.op -o .env.local
#
# Works in every devbox shell because OP_SERVICE_ACCOUNT_TOKEN is auto-loaded from
# main.env. In non-interactive ssh commands use `bash -l` so main.env loads.
#
# Reference format: op://<vault>/<item>/<field>
# TIP: in scripts, target the vault by UUID, not name — vault names can be ambiguous
# across accounts and `op` may resolve to the wrong one.

DATABASE_URL=op://Dev/myproject-env/database-url
STRIPE_SECRET_KEY=op://Dev/myproject-env/stripe-secret-key
RESEND_API_KEY=op://Dev/myproject-env/resend-api-key
